# Copy to .dev.vars locally. Never commit real values.
# Optional: without a key, clearly labelled lexical retrieval and baseline analysis run.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Machine token for /api/cron on self-hosted deployments.
CRON_SECRET=
# Local development only. Never enable on a public deployment.
ALLOW_LOCAL_DEV=true

# Sites only: trust headers injected by its authentication gateway.
TRUST_SITES_AUTH=false
# Standalone hosting: protect the entire dashboard with a strong password.
DASHBOARD_PASSWORD=
