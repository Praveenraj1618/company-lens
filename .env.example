# Copy to .dev.vars locally. Never commit real values.
# Optional: without a key, clearly labelled lexical retrieval and baseline analysis run.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Machine token for /api/cron on self-hosted deployments.
CRON_SECRET=
# Local development only. Never enable on a public deployment.
ALLOW_LOCAL_DEV=true

# Sites only: trust headers injected by its authentication gateway.
TRUST_SITES_AUTH=false
# Standalone hosting: protect the entire dashboard with a strong password.
DASHBOARD_PASSWORD=

# Standalone runtime: collect due sources even with the browser closed.
SCHEDULE_ENABLED=true
# Optional overrides: PORT=3000, HOST=127.0.0.1, DATABASE_PATH=.data/company-lens.sqlite

# Hosted scheduled coverage (optional on a separate installation):
# COVERAGE_REPOSITORY=owner/repo
# COVERAGE_PRIVATE_KEY=<private RSA JWK as a server secret; never commit>
